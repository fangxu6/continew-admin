<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="wms_item_20251230" author="speckit">
        <createTable tableName="wms_item">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="category" type="VARCHAR(64)"/>
            <column name="unit" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="length" type="DECIMAL(10,2)"/>
            <column name="width" type="DECIMAL(10,2)"/>
            <column name="height" type="DECIMAL(10,2)"/>
            <column name="weight" type="DECIMAL(10,2)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" type="BIGINT"/>
            <column name="update_by" type="BIGINT"/>
        </createTable>
        <addUniqueConstraint tableName="wms_item" columnNames="code" constraintName="uk_wms_item_code"/>
        <createIndex tableName="wms_item" indexName="idx_wms_item_name">
            <column name="name"/>
        </createIndex>
        <createIndex tableName="wms_item" indexName="idx_wms_item_category">
            <column name="category"/>
        </createIndex>
        <createIndex tableName="wms_item" indexName="idx_wms_item_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="wms_customer_20251230" author="speckit">
        <createTable tableName="wms_customer">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="contact" type="VARCHAR(100)"/>
            <column name="phone" type="VARCHAR(20)"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="address" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="credit_level" type="VARCHAR(32)"/>
            <column name="remark" type="TEXT"/>
            <column name="create_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" type="BIGINT"/>
            <column name="update_by" type="BIGINT"/>
        </createTable>
        <addUniqueConstraint tableName="wms_customer" columnNames="code" constraintName="uk_wms_customer_code"/>
        <createIndex tableName="wms_customer" indexName="idx_wms_customer_name">
            <column name="name"/>
        </createIndex>
        <createIndex tableName="wms_customer" indexName="idx_wms_customer_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="wms_customer" indexName="idx_wms_customer_phone">
            <column name="phone"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
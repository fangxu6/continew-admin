<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="wms_location_20251230" author="speckit">
        <createTable tableName="wms_location">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="warehouse_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="area" type="VARCHAR(64)"/>
            <column name="row" type="VARCHAR(32)"/>
            <column name="column" type="VARCHAR(32)"/>
            <column name="level" type="VARCHAR(32)"/>
            <column name="position" type="VARCHAR(32)"/>
            <column name="type" type="VARCHAR(32)"/>
            <column name="capacity" type="DECIMAL(15,2)"/>
            <column name="used_capacity" type="DECIMAL(15,2)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="remark" type="TEXT"/>
            <column name="create_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" type="BIGINT"/>
            <column name="update_by" type="BIGINT"/>
        </createTable>
        <addUniqueConstraint tableName="wms_location" columnNames="code" constraintName="uk_wms_location_code"/>
        <createIndex tableName="wms_location" indexName="idx_wms_location_warehouse_id">
            <column name="warehouse_id"/>
        </createIndex>
        <createIndex tableName="wms_location" indexName="idx_wms_location_name">
            <column name="name"/>
        </createIndex>
        <createIndex tableName="wms_location" indexName="idx_wms_location_type">
            <column name="type"/>
        </createIndex>
        <createIndex tableName="wms_location" indexName="idx_wms_location_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>